# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit it.

# MongoDB connection string (local, or from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/todo-app?retryWrites=true&w=majority

# Port the Express server listens on
PORT=5000

# The one origin allowed to call this API (your React dev server)
FRONTEND_ORIGIN=http://localhost:3000
